{
  "name": "jobpilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/prepare.mjs",
    "secrets:scan": "gitleaks dir --redact .",
    "db:migrate": "pnpm --filter @jobpilot/db migrate",
    "db:generate": "pnpm --filter @jobpilot/db generate",
    "db:seed": "pnpm --filter @jobpilot/db seed"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "eslint": "9.39.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.6.2",
    "turbo": "2.6.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css}": "prettier --write"
  }
}
