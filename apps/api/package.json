{
  "name": "@jobpilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "cli": "node --env-file-if-exists=../../.env --import tsx src/cli.ts"
  },
  "devDependencies": {
    "@jobpilot/config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "supertest": "7.2.2",
    "@types/supertest": "6.0.3",
    "vitest": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "testcontainers": "12.2.1"
  },
  "dependencies": {
    "@jobpilot/db": "workspace:*",
    "@jobpilot/shared": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/swagger": "12.1.0",
    "argon2": "0.45.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "cookie-parser": "1.4.7",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  }
}
