# Local infrastructure: set unique passwords before starting Compose.
POSTGRES_USER=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
# Required by future application services; never commit real values.
NODE_ENV=development
APP_NAME=JobPilot
DATABASE_URL=
VALKEY_URL=
ENCRYPTION_KEY=
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional application defaults.
REGISTRATION_ENABLED=false
COLLECTION_COOLDOWN_MINUTES=30
SCORING_LLM_TOP_N=30
JOB_RETENTION_DAYS=60
EMBEDDING_DIMENSIONS=1024
LLM_MONTHLY_TOKEN_LIMIT=2000000
DEFAULT_LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://localhost:11434
EMAIL_ALERT_ALLOWED_SENDERS=
ALLOW_PRIVATE_IMAP_HOST=false
# Empty backup configuration disables backups.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_AGE_RECIPIENT=
LOG_LEVEL=info

# Override host ports when other local services use the defaults.
VALKEY_PORT=6379
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025

# Required only for db:seed: argon2id hash of a local development password.
SEED_PASSWORD_HASH=

# API listener and explicitly trusted proxy hops (0 for direct local access).
API_HOST=127.0.0.1
API_PORT=3001
TRUST_PROXY_HOPS=0
# Encryption rotation: keep old keys until all secrets have been re-encrypted.
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_PREVIOUS_KEYS={}
# CLI only; provide temporarily in the shell and clear after use.
CLI_USER_EMAIL=
CLI_USER_PASSWORD=

# Internal worker readiness listener; never publish this port.
WORKER_HEALTH_PORT=3002
# Standalone web runtime listener (container defaults).
PORT=3000
HOSTNAME=0.0.0.0

# AI calls: bounds apply to API and worker. Pricing is optional, in USD per million tokens.
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=8192
LLM_PRICING_JSON={}
# Only these administrator-approved Ollama origins may receive documents.
OLLAMA_ALLOWED_ORIGINS=http://localhost:11434,http://127.0.0.1:11434,http://srv-captain--ollama:11434
# Collection limits shared by API and worker. Quotas are instance limits, not provider entitlements.
COLLECTION_COOLDOWN_MINUTES=30
COLLECTION_QUEUE_PREFIX=jobpilot
COLLECTION_MAX_REQUESTS=200
COLLECTION_MAX_OFFERS=500
COLLECTION_MAX_PAGES=5
ADZUNA_DAILY_REQUEST_LIMIT=100
JOBPILOT_REPOSITORY_URL=https://github.com/sepiiroth/jobpilot
